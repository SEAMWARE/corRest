--NAME--
GET entity by ID (single wildcard)

--INIT--
swBrokerStart

--RUN--
echo "01. GET /api/v1/entities/E1"
echo "==========================="
swCurl --url /api/v1/entities/E1
echo "02. GET /api/v1/entities/urn:ngsi-ld:Entity:123"
echo "================================================"
swCurl --url /api/v1/entities/urn:ngsi-ld:Entity:123

--EXPECT--
01. GET /api/v1/entities/E1
===========================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{"id":"E1"}
02. GET /api/v1/entities/urn:ngsi-ld:Entity:123
================================================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{"id":"urn:ngsi-ld:Entity:123"}

--TEARDOWN--
swBrokerStop

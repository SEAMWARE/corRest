--NAME--
GET ping

--INIT--
coraineStart

--RUN--
echo "01. GET /api/v1/ping"
echo "====================="
corCurl --url /api/v1/ping

--EXPECT--
01. GET /api/v1/ping
=====================
HTTP/1.1 200 OK
Date: REGEX(.*)
Content-Type: application/json
Content-Length: 15

{"ping":"pong"}

--TEARDOWN--
coraineStop

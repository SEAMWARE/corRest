--NAME--
404 Not Found for unknown URL (RFC 9457 Problem Details)

--INIT--
coraineStart

--RUN--
echo "01. GET /no/such/path - 404"
echo "==========================="
corCurl --url /no/such/path

--EXPECT--
01. GET /no/such/path - 404
===========================
HTTP/1.1 404 Not Found
Date: REGEX(.*)
Content-Type: application/json
Content-Length: REGEX(\d+)

{"type":"https://uri.etsi.org/ngsi-ld/errors/ResourceNotFound","title":"Not Found","detail":"GET /no/such/path is not a recognized resource"}

--TEARDOWN--
coraineStop
